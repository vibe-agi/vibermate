{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "react"]
  },
  "include": ["index.client.tsx", "index.server.ts", "client/**/*.tsx", "client/**/*.ts", "server/**/*.ts", "shared/**/*.ts"]
}
