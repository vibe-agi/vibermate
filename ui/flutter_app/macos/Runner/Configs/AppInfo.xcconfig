// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = ViberMate

// Keep the native shell and packaged terminal command as distinct files on
// case-insensitive macOS volumes. The user-facing product name remains
// ViberMate; this value is only the private CFBundleExecutable identity.
EXECUTABLE_NAME = vibermate-desktop

// The application's bundle identifier
// This is also the authority used by runtimepath, Keychain, the CLI discovery
// record, and packaged acceptance. A Desktop shell must not invent a second
// per-user runtime namespace merely because its UI toolkit changed.
PRODUCT_BUNDLE_IDENTIFIER = io.vibermate.desktop

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 io.vibermate. All rights reserved.
