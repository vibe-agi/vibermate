{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViberMate",
  "version": "0.1.0",
  "identifier": "io.vibermate.desktop",
  "build": {
    "beforeDevCommand": "pnpm run prepare:desktop:development && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run prepare:desktop:bundle && pnpm build",
    "beforeBundleCommand": "pnpm run verify:desktop:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViberMate",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/vibermated",
      "binaries/vibermate"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "../../../LICENSE": "LICENSE",
      "binaries/vibermate-build-manifest.json": "vibermate-build-manifest.json"
    }
  }
}
