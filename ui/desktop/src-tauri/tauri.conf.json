{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeMate",
  "version": "0.0.0",
  "identifier": "io.vibermate.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeMate",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/vibermated",
      "binaries/vibermate"
    ],
    "resources": {
      "binaries/vibermate-build-manifest.json": "vibermate-build-manifest.json"
    }
  }
}
