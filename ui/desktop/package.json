{
  "name": "@vibermate/desktop",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "pnpm run check:generated && pnpm run check:build-policy && tsc --noEmit && vite build",
    "bundle:development": "node scripts/run-desktop-bundle.mjs --profile=development",
    "bundle:packaged-acceptance": "node scripts/run-desktop-bundle.mjs --profile=release",
    "candidate:macos:build-unsigned": "node scripts/build-macos-distribution-candidate.mjs",
    "candidate:macos:create-unsigned-archive": "node scripts/create-macos-unsigned-archive.mjs",
    "candidate:macos:create-signed-transfer": "node scripts/create-macos-signed-transfer.mjs",
    "candidate:macos:create-installed-evidence": "node scripts/create-macos-installed-candidate-evidence.mjs",
    "candidate:macos:bundle-signed": "node scripts/bundle-macos-distribution-candidate.mjs",
    "candidate:macos:notarize": "node scripts/notarize-macos-distribution-candidate.mjs",
    "candidate:macos:preflight-unsigned": "node scripts/preflight-macos-unsigned-candidate.mjs",
    "candidate:macos:restore-unsigned-archive": "node scripts/restore-macos-unsigned-archive.mjs",
    "candidate:macos:restore-signed-transfer": "node scripts/restore-macos-signed-transfer.mjs",
    "candidate:macos:verify-signed": "node scripts/verify-macos-signed-candidate.mjs",
    "candidate:macos:verify-installed-evidence": "node scripts/verify-macos-installed-candidate-evidence.mjs",
    "candidate:r0:create-input-transfer": "node scripts/create-r0-build-input-transfer.mjs",
    "candidate:r0:restore-input-transfer": "node scripts/restore-r0-build-input-transfer.mjs",
    "check": "pnpm run check:generated && pnpm run check:build-policy && tsc --noEmit && vitest run && vite build",
    "check:browser": "playwright test",
    "check:build-policy": "node --test scripts/desktop-build-policy.test.mjs scripts/macos-application-archive.test.mjs scripts/macos-distribution-policy.test.mjs scripts/macos-developer-id-workflow.test.mjs scripts/macos-installed-candidate-evidence.test.mjs scripts/r0-build-input-transfer.test.mjs",
    "check:generated": "node scripts/sync-generated.mjs --check",
    "dev": "vite",
    "generate": "node scripts/sync-generated.mjs",
    "generate:icons": "pnpm exec tauri icon src-tauri/icon.svg --output src-tauri/icons",
    "prepare:desktop": "pnpm run prepare:desktop:development",
    "prepare:desktop:bundle": "node scripts/prepare-desktop-bundle.mjs",
    "prepare:desktop:development": "pnpm run generate:icons && pnpm run prepare:sidecars:development",
    "prepare:desktop:distribution": "pnpm run generate:icons && pnpm run prepare:sidecars:distribution",
    "prepare:desktop:release": "pnpm run generate:icons && pnpm run prepare:sidecars:release",
    "prepare:sidecars": "pnpm run prepare:sidecars:development",
    "prepare:sidecars:development": "node scripts/build-sidecars.mjs --profile=development",
    "prepare:sidecars:distribution": "node scripts/build-sidecars.mjs --profile=distribution",
    "prepare:sidecars:release": "node scripts/build-sidecars.mjs --profile=release",
    "tauri": "pnpm exec tauri",
    "verify:desktop:bundle": "node scripts/verify-desktop-bundle.mjs"
  },
  "dependencies": {
    "@tanstack/history": "1.162.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tauri-apps/api": "2.11.1",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
