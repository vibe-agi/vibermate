# Copy to .env.private. Pick exactly one client-facing identity:
#   DNS: vibermate.home.arpa:9666, then map that name on each client
#   IP:  192.168.1.20:9666, then connect directly by IP
VIBERMATE_ACCESS_ADDRESS=vibermate.home.arpa:9666
VIBERMATE_PRIVATE_BIND_ADDRESS=192.168.1.20
VIBERMATE_PORT=9666
VIBERMATE_PRIVATE_DATA_VOLUME=vibermate-private-data

# The image is built locally by tool/docker/build-local.sh.
VIBERMATE_IMAGE=vibermate-runtime:0.1.10-local
