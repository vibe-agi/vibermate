# Copy to .env.team and replace all three paths/addresses before starting.
# This is the host's interface, not the public URL or a container IP.
VIBERMATE_TEAM_BIND_ADDRESS=192.168.1.20
VIBERMATE_PORT=9666

# Absolute paths to regular PEM files (not Certbot symlinks). The server
# certificate must cover the DNS name/IP clients actually use. The private
# key must be readable by UID 10001, with owner-only permissions (0600).
VIBERMATE_TLS_CERT_FILE=/absolute/path/to/fullchain.pem
VIBERMATE_TLS_KEY_FILE=/absolute/path/to/privkey.pem

# Obtain/renew the Server HTTPS certificate with your chosen issuer. This
# is separate from ViberMate's Proxy CA; never distribute either private key.
