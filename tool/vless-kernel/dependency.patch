new file mode 100644
index 0000000..389cbf5
--- /dev/null
+++ b/transport/internet/setup.go
@@ -0,0 +1,34 @@
+package internet
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+type setupKey struct{}
+type setupTasks struct{ sync.WaitGroup }
+
+// NewConnectionSetup owns only connection establishment and failed-attempt
+// cleanup. Call finish after the final Dial returns, before transferring the
+// accepted connection to traffic. No successful connection belongs to the group.
+func NewConnectionSetup(parent context.Context, budget time.Duration) (context.Context, func()) {
+	ctx, cancel := context.WithTimeout(parent, budget)
+	tasks := &setupTasks{}
+	ctx = context.WithValue(ctx, setupKey{}, tasks)
+	return ctx, func() { cancel(); tasks.Wait() }
+}
+
+// RunSetupTask registers synchronously before starting work, so the final dial
+// cannot race registration with finish. Tasks must observe ctx and join their
+// own children. Non-VLESS callers get a bounded independent owner as well.
+func RunSetupTask(ctx context.Context, task func(context.Context)) {
+	tasks, owned := ctx.Value(setupKey{}).(*setupTasks)
+	if owned {
+		tasks.Add(1)
+		go func() { defer tasks.Done(); task(ctx) }()
+		return
+	}
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	go func() { defer cancel(); task(ctx) }()
+}
