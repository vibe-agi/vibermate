+
+// One budget covers all outer dial/handshake attempts. The original Process
+// context remains the owner of established traffic, including long streams.
+func dialWithSetup(parent context.Context, budget time.Duration, dial func(context.Context) (stat.Connection, error)) (stat.Connection, error) {
+	ctx, finish := internet.NewConnectionSetup(parent, budget)
+	defer finish()
+	var last error
+	for attempt := 0; attempt < 5; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if attempt > 1 {
+			timer := time.NewTimer(time.Duration(attempt-1) * 200 * time.Millisecond)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return nil, ctx.Err()
+			case <-timer.C:
+			}
+		}
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		conn, err := dial(ctx)
+		if ctx.Err() != nil {
+			if conn != nil {
+				conn.Close()
+			}
+			return nil, ctx.Err()
+		}
+		if err == nil {
+			return conn, nil
+		}
+		if conn != nil {
+			conn.Close()
+		}
+		last = err
+	}
+	return nil, last
+}
diff --git a/proxy/vless/outbound/setup_test.go b/proxy/vless/outbound/setup_test.go
new file mode 100644
index 0000000..e83e28f
--- /dev/null
+++ b/proxy/vless/outbound/setup_test.go
@@ -0,0 +1,102 @@
+package outbound
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func TestSetupRetriesShareBudget(t *testing.T) {
+	var calls int
+	start := time.Now()
+	_, err := dialWithSetup(t.Context(), 80*time.Millisecond, func(ctx context.Context) (stat.Connection, error) {
+		calls++
+		if calls == 1 {
+			return nil, errors.New("first attempt failed")
+		}
+		<-ctx.Done()
+		return nil, ctx.Err()
+	})
+	if !errors.Is(err, context.DeadlineExceeded) || calls != 2 || time.Since(start) > time.Second {
+		t.Fatalf("setup budget/retries: calls=%d, elapsed=%s, error=%v", calls, time.Since(start), err)
+	}
+}
+
+func TestSetupCancellationJoinsFailedTasksAndRejectsLateConnection(t *testing.T) {
+	parent, cancel := context.WithCancel(t.Context())
+	client, peer := net.Pipe()
+	defer peer.Close()
+	var joined atomic.Bool
+	conn, err := dialWithSetup(parent, time.Second, func(ctx context.Context) (stat.Connection, error) {
+		internet.RunSetupTask(ctx, func(ctx context.Context) { <-ctx.Done(); joined.Store(true) })
+		cancel()
+		return client, nil
+	})
+	if conn != nil || !errors.Is(err, context.Canceled) || !joined.Load() {
+		t.Fatalf("canceled setup retained ownership: %v", err)
+	}
+	if _, err := peer.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatalf("late socket still open: %v", err)
+	}
+}
+
+func TestSuccessfulSetupDetachesTrafficAndJoinsEarlierFailure(t *testing.T) {
+	client, peer := net.Pipe()
+	defer client.Close()
+	defer peer.Close()
+	var calls int
+	var joined atomic.Bool
+	conn, err := dialWithSetup(t.Context(), 40*time.Millisecond, func(ctx context.Context) (stat.Connection, error) {
+		calls++
+		if calls == 1 {
+			internet.RunSetupTask(ctx, func(ctx context.Context) { <-ctx.Done(); joined.Store(true) })
+			return nil, errors.New("failed setup has cleanup work")
+		}
+		return client, nil
+	})
+	if err != nil || !joined.Load() {
+		t.Fatalf("setup did not join prior failure: %v", err)
+	}
+	time.Sleep(60 * time.Millisecond)
+	_ = peer.SetDeadline(time.Now().Add(time.Second))
+	go conn.Write([]byte("alive"))
+	data := make([]byte, 5)
+	if _, err := io.ReadFull(peer, data); err != nil || string(data) != "alive" {
+		t.Fatalf("successful traffic inherited setup deadline: %v", err)
+	}
+}
+
+func TestSetupCancellationInterruptsRetryWait(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		parent, cancel := context.WithCancel(t.Context())
+		var calls int
+		finished := make(chan error, 1)
+		go func() {
+			_, err := dialWithSetup(parent, time.Second, func(context.Context) (stat.Connection, error) {
+				calls++
+				return nil, errors.New("failed")
+			})
+			finished <- err
+		}()
+		synctest.Wait() // Both immediate attempts returned; the retry timer is waiting.
+		if calls != 2 {
+			t.Fatalf("did not reach retry wait: %d", calls)
+		}
+		before := time.Now()
+		cancel()
+		if err := <-finished; !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+		if calls != 2 || time.Since(before) != 0 {
+			t.Fatal("cancellation waited for retry timer or dialed again")
+		}
+	})
+}
