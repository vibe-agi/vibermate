@@ -0,0 +1,123 @@
+package reality
+
+import (
+	"bytes"
+	"context"
+	gotls "crypto/tls"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// This exercises the resource owner after certificate verification, not the
+// authentication decision. The peer and its trust roots are process-local.
+func TestRejectedSetupOwnsHTTP2Requests(t *testing.T) {
+	for _, mode := range []string{"headers", "body", "idle", "overflow"} {
+		t.Run(mode, func(t *testing.T) {
+			entered := make(chan struct{}, 1)
+			var calls atomic.Int32
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				if r.URL.Path != "/" || r.Method != "GET" || r.UserAgent() == "" {
+					t.Error("existing request contract lost")
+				}
+				entered <- struct{}{}
+				switch mode {
+				case "headers":
+					<-r.Context().Done()
+				case "body":
+					w.WriteHeader(200)
+					w.(http.Flusher).Flush()
+					<-r.Context().Done()
+				case "idle":
+					io.WriteString(w, `<a href="/retained">ok</a>`)
+				case "overflow":
+					w.Write(bytes.Repeat([]byte("x"), maxSpiderBody+1))
+				}
+			}))
+			server.EnableHTTP2 = true
+			server.StartTLS()
+			defer server.Close()
+			raw, err := net.Dial("tcp", server.Listener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer raw.Close()
+			config := server.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+			config.ServerName = "example.com"
+			config.NextProtos = []string{"h2"}
+			secure := gotls.Client(raw, config)
+			if err := secure.HandshakeContext(t.Context()); err != nil {
+				t.Fatal(err)
+			}
+			maps.Lock()
+			delete(maps.maps, "example.com")
+			maps.Unlock()
+			ctx, finish := internet.NewConnectionSetup(t.Context(), time.Second)
+			defer finish()
+			startSpider(ctx, raw, secure, "example.com", &Config{SpiderX: "/", SpiderY: make([]int64, 10)})
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("existing request did not start")
+			}
+			// Idle/oversize task completion must close its socket independently.
+			if mode == "idle" || mode == "overflow" {
+				deadline := time.Now().Add(500 * time.Millisecond)
+				for {
+					err := raw.SetReadDeadline(time.Now().Add(time.Second))
+					if err != nil {
+						break
+					}
+					if time.Now().After(deadline) {
+						t.Fatal("completed setup retained raw socket")
+					}
+					time.Sleep(time.Millisecond)
+				}
+			}
+			finished := make(chan struct{})
+			go func() { finish(); close(finished) }()
+			select {
+			case <-finished:
+			case <-time.After(time.Second):
+				t.Fatal("setup did not join HTTP2 cleanup")
+			}
+			if calls.Load() != 1 {
+				t.Fatalf("unexpected replacement requests: %d", calls.Load())
+			}
+		})
+	}
+}
+
+func TestRejectedSetupResourceCaps(t *testing.T) {
+	if _, err := readSpiderBody(bytes.NewReader(make([]byte, maxSpiderBody))); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readSpiderBody(bytes.NewReader(make([]byte, maxSpiderBody+1))); err == nil {
+		t.Fatal("body cap not enforced")
+	}
+	paths := map[string]struct{}{"/": {}}
+	var body bytes.Buffer
+	for i := 0; i < 1000; i++ {
+		fmt.Fprintf(&body, `<a href="/path%d">x</a>`, i)
+	}
+	retainSpiderPaths(paths, []byte("https://example.com"), body.Bytes())
+	if len(paths) != maxSpiderPaths {
+		t.Fatalf("path cap: %d", len(paths))
+	}
+	if _, ok := paths["/"]; !ok {
+		t.Fatal("initial path removed")
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if waitSpider(ctx, time.Hour) {
+		t.Fatal("canceled wait succeeded")
+	}
+}
