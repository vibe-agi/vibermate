# Existing HTTPS profile (compose.yaml). Keep loopback unless deliberately
# enabling remote access with matching HTTPS identity and firewall rules.
VIBERMATE_BIND_ADDRESS=127.0.0.1
VIBERMATE_PORT=9666

# New local-only HTTP setup: docker compose -f compose.local.yaml up -d --wait
# This profile always publishes loopback and uses its own persistent volume.
# Set VIBERMATE_PORT=9667 if the App already uses 9666.
# Native Web (no Docker) uses CLI flags, not this file; see docs/deployment.md.

# Team HTTPS setup: copy .env.team.example to .env.team and follow docs/docker.md.
# TLS certificate files are deployment-owned. The settings page exports the
# public Proxy CA; it does not edit domains, issue external certificates or
# reload server TLS. Never put passwords, Recovery Keys or private keys here.
