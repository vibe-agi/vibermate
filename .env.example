# Default compose.yaml is local-only HTTP and always binds host loopback.
VIBERMATE_PORT=9666
VIBERMATE_LOCAL_DATA_VOLUME=vibermate-local-data
VIBERMATE_IMAGE=vibermate-runtime:0.1.10-local

# Remote profiles each have their own explicit example file:
#   .env.private.example — private CA, DNS + hosts file or direct IP
#   .env.public.example  — automatic public HTTPS
#   .env.team.example    — operator-provided certificate files
# Never put passwords, Recovery Keys or private keys in an env file.
