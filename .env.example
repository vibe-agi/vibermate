# Host interface exposed by Docker. Keep loopback for local-only access.
VIBERMATE_BIND_ADDRESS=127.0.0.1
VIBERMATE_PORT=9667

# Configure certificate IPs / DNS names in Settings > Security & data.
# Certificate settings persist in the data volume, not in this environment.

# LAN example (replace with the real host address):
# VIBERMATE_BIND_ADDRESS=192.168.1.20
