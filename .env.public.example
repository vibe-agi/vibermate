# Copy to .env.public. This must be a public DNS name whose TCP 443 reaches
# this host. Do not include a scheme, path or port.
VIBERMATE_PUBLIC_HOST=runtime.example.com
VIBERMATE_ACME_EMAIL=admin@example.com
VIBERMATE_PUBLIC_BIND_ADDRESS=0.0.0.0
VIBERMATE_PUBLIC_DATA_VOLUME=vibermate-public-data

# The image is built locally by tool/docker/build-local.sh.
VIBERMATE_IMAGE=vibermate-runtime:local

# Only when a layer-4 load balancer in front of this host sends PROXY protocol
# headers: the load balancer's own addresses (never client networks), so the
# IP allowlist sees real clients. "none" trusts no one.
VIBERMATE_TRUSTED_PROXIES=none
